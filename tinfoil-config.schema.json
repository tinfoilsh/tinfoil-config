{
	"$id": "https://tinfoil.sh/schemas/tinfoil-config.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"attested-keys": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"gid": {
						"type": "integer"
					},
					"id": {
						"type": "string"
					},
					"key": {
						"type": "string"
					},
					"uid": {
						"type": "integer"
					}
				},
				"type": "object"
			},
			"type": "array"
		},
		"containers": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"attestation": {
						"type": "boolean"
					},
					"cap_add": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"command": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"cpus": {
						"description": "A decimal quantity, written as a string.",
						"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
						"type": "string"
					},
					"cvm_admin": {
						"type": "boolean"
					},
					"devices": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"entrypoint": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"env": {
						"items": {
							"oneOf": [
								{
									"description": "The name of a variable taken from the deployment's environment.",
									"type": "string"
								},
								{
									"additionalProperties": {
										"type": "string"
									},
									"description": "One variable and its literal value.",
									"maxProperties": 1,
									"minProperties": 1,
									"type": "object"
								}
							]
						},
						"type": "array"
					},
					"gpus": {
						"oneOf": [
							{
								"type": "integer"
							},
							{
								"type": "string"
							}
						]
					},
					"healthcheck": {
						"additionalProperties": false,
						"properties": {
							"interval": {
								"type": "string"
							},
							"retries": {
								"type": "integer"
							},
							"start_period": {
								"type": "string"
							},
							"test": {
								"items": {
									"type": "string"
								},
								"type": "array"
							},
							"timeout": {
								"type": "string"
							}
						},
						"type": "object"
					},
					"image": {
						"type": "string"
					},
					"ipc": {
						"type": "string"
					},
					"keys": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"memory": {
						"type": "string"
					},
					"models": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"name": {
						"type": "string"
					},
					"networks": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"persistent_volumes": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"pid": {
						"type": "string"
					},
					"pids_limit": {
						"type": "integer"
					},
					"ports": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"provenance": {
						"additionalProperties": false,
						"properties": {
							"github": {
								"additionalProperties": false,
								"properties": {
									"commit": {
										"type": "string"
									},
									"ref": {
										"type": "string"
									},
									"repository": {
										"type": "string"
									},
									"repository_id": {
										"pattern": "^[1-9][0-9]{0,17}$",
										"type": "string"
									},
									"workflow": {
										"type": "string"
									}
								},
								"type": "object"
							}
						},
						"type": "object"
					},
					"read_only": {
						"type": "boolean"
					},
					"restart": {
						"type": "string"
					},
					"runtime": {
						"type": "string"
					},
					"seal_register": {
						"type": "boolean"
					},
					"secrets": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"shm_size": {
						"type": "string"
					},
					"stop_signal": {
						"type": "string"
					},
					"stop_timeout": {
						"type": "integer"
					},
					"tmpfs": {
						"additionalProperties": {
							"type": "string"
						},
						"type": "object"
					},
					"user": {
						"type": "string"
					},
					"volumes": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"working_dir": {
						"type": "string"
					}
				},
				"type": "object"
			},
			"type": "array"
		},
		"cpus": {
			"type": "integer"
		},
		"cvm-network": {
			"additionalProperties": false,
			"properties": {
				"inbound-ports": {
					"items": {
						"type": "integer"
					},
					"type": "array"
				}
			},
			"type": "object"
		},
		"cvm-version": {
			"type": "string"
		},
		"gpus": {
			"type": "integer"
		},
		"keyserver-url": {
			"type": "string"
		},
		"memory": {
			"type": "integer"
		},
		"models": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"emwp": {
						"type": "string"
					},
					"exec": {
						"type": "boolean"
					},
					"key-secret": {
						"type": "string"
					},
					"mpk": {
						"type": "string"
					},
					"mwp": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"repo": {
						"type": "string"
					},
					"schema": {
						"type": "integer"
					}
				},
				"type": "object"
			},
			"type": "array"
		},
		"networks": {
			"additionalProperties": {
				"additionalProperties": false,
				"properties": {
					"allow": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"egress": {
						"type": "string"
					}
				},
				"type": "object"
			},
			"type": "object"
		},
		"security": {
			"additionalProperties": false,
			"properties": {
				"allow-unencrypted-nvlink": {
					"type": "boolean"
				},
				"include-config-in-attestation": {
					"type": "boolean"
				}
			},
			"type": "object"
		},
		"shim": {
			"additionalProperties": false,
			"properties": {
				"atc": {
					"type": "string"
				},
				"authenticated": {
					"type": "boolean"
				},
				"authenticated-endpoints": {
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				"control-plane": {
					"type": "string"
				},
				"drain_connections": {
					"type": "boolean"
				},
				"drain_timeout": {
					"description": "A duration such as 5m or 90s.",
					"type": "string"
				},
				"dummy-attestation": {
					"type": "boolean"
				},
				"email": {
					"type": "string"
				},
				"expected-gpus": {
					"type": "integer"
				},
				"origins": {
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				"paths": {
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				"publish-attestation": {
					"type": "boolean"
				},
				"rate-burst": {
					"type": "integer"
				},
				"rate-limit": {
					"description": "A decimal quantity, written as a string.",
					"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
					"type": "string"
				},
				"tls-challenge": {
					"type": "string"
				},
				"tls-env": {
					"type": "string"
				},
				"tls-mode": {
					"type": "string"
				},
				"tls-own-san-domain": {
					"type": "boolean"
				},
				"tls-wildcard": {
					"type": "boolean"
				},
				"upstream-container": {
					"type": "string"
				},
				"upstream-port": {
					"type": "integer"
				}
			},
			"type": "object"
		},
		"volumes": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"exec": {
						"type": "boolean"
					},
					"key-secret": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"overlays": {
						"items": {
							"additionalProperties": false,
							"properties": {
								"model": {
									"type": "string"
								},
								"source": {
									"type": "string"
								},
								"target": {
									"type": "string"
								}
							},
							"type": "object"
						},
						"type": "array"
					},
					"owner": {
						"type": "string"
					},
					"size": {
						"type": "string"
					}
				},
				"type": "object"
			},
			"type": "array"
		}
	},
	"required": [
		"cvm-version",
		"shim"
	],
	"title": "Tinfoil enclave config",
	"type": "object"
}
